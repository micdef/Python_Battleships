# Environnement virtuel Python : propre à chaque poste, recréé localement
.venv/

# Bytecode généré automatiquement par Python
__pycache__/
*.py[cod]

# Configuration locale des éditeurs : propre à chaque poste, le dépôt reste neutre
# PyCharm
.idea/
# Visual Studio (projet, solution et réglages ; le fichier de projet standard reste pyproject.toml)
.vs/
*.pyproj
*.pyproj.user
*.sln
*.slnx
# Résultats de l'explorateur de tests de Visual Studio
TestResults/

# Cache local de pytest
.pytest_cache/

# Cache local de Ruff
.ruff_cache/
